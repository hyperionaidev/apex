        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "checkable",
            "needs_signature",
            "needs_intent",
            "float_code",
            "not_exported",
            "ui",
            "impure",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "status",
        "reason"
      ],
      "title": "FunctionSurvey",
      "type": "object"
    },
    "ParamClue": {
      "properties": {
        "compared_to": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
