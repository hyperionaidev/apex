    },
    "profile_problems": {
      "items": {
        "type": "string"
      },
      "title": "Profile Problems",
      "type": "array"
    },
    "root": {
      "title": "Root",
      "type": "string"
    },
    "skipped_files": {
      "items": {
        "type": "string"
      },
      "title": "Skipped Files",
      "type": "array"
    },
    "stack": {
      "items": {
        "type": "string"
      },
      "title": "Stack",
      "type": "array"
    }
