                {
                  "type": "integer"
                }
              ]
            },
            "type": "array"
          },
          "title": "Compared To",
          "type": "object"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "used_as": {
          "items": {
            "type": "string"
          },
          "title": "Used As",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ParamClue",
      "type": "object"
    }
  },
  "properties": {
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "functions": {
