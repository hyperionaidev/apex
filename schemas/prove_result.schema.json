{
  "$defs": {
    "ProofTask": {
      "description": "An open theorem for the coding agent to prove.",
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "goal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "spec_file": {
          "title": "Spec File",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "strategy": {
          "items": {
            "type": "string"
          },
          "title": "Strategy",
          "type": "array"
        },
        "unfold": {
          "items": {
            "type": "string"
          },
          "title": "Unfold",
          "type": "array"
        }
      },
      "required": [
        "property_id",
        "statement",
        "spec_file"
      ],
      "title": "ProofTask",
      "type": "object"
    }
  },
  "properties": {
    "attempts": {
      "additionalProperties": {
        "type": "integer"
      },
      "default": {},
      "title": "Attempts",
      "type": "object"
    },
    "closed": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Closed",
      "type": "object"
    },
    "duration_s": {
      "title": "Duration S",
      "type": "number"
    },
    "errors": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Errors",
      "type": "object"
    },
    "open": {
      "items": {
        "type": "string"
      },
      "title": "Open",
      "type": "array"
    },
    "proposed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed By"
    },
    "skipped": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Skipped",
      "type": "object"
    },
    "spec_path": {
      "title": "Spec Path",
      "type": "string"
    },
    "tasks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProofTask"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "spec_path",
    "closed",
    "open",
    "duration_s"
  ],
  "title": "ProveResult",
  "type": "object"
}
